root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off

[*.{js,jsx,ts,tsx,json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.{py,sol}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[Dockerfile]
indent_style = space
indent_size = 2
