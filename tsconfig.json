{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node", "mocha"]
  },
  "include": ["hardhat.config.ts", "contracts/test/**/*.ts", "typechain-types/**/*.d.ts"]
}
