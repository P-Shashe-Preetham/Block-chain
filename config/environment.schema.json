{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/blockchain-secure-platform/environment.schema.json",
  "title": "Blockchain Secure Platform environment",
  "description": "Repository configuration contract. Values in .env.example are local-only placeholders and must never be used for testnet, pilot, or production.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "NODE_ENV": {"type": "string", "enum": ["development", "test", "production"]},
    "APP_ENV": {"type": "string", "enum": ["local", "ci", "development", "testnet", "pilot", "production"]},
    "APP_NAME": {"type": "string", "minLength": 1},
    "APP_URL": {"type": "string", "format": "uri"},
    "API_URL": {"type": "string", "format": "uri"},
    "CHAIN_ID": {"type": "string", "pattern": "^[0-9]+$"},
    "RPC_URL": {"type": "string", "format": "uri"},
    "CONFIRMATION_BLOCKS": {"type": "string", "pattern": "^[0-9]+$"},
    "CONTRACT_ADDRESS": {"type": "string", "pattern": "^0x[a-fA-F0-9]{40}$"},
    "CONTRACT_DEPLOYMENT_VERSION": {"type": "string", "minLength": 1},
    "DEPLOYER_PRIVATE_KEY": {"type": "string", "minLength": 1, "writeOnly": true},
    "ADMIN_PRIVATE_KEY": {"type": "string", "minLength": 1, "writeOnly": true},
    "AUTH_ISSUER": {"type": "string", "format": "uri"},
    "AUTH_AUDIENCE": {"type": "string", "minLength": 1},
    "AUTH_JWKS_URL": {"type": "string", "format": "uri"},
    "SESSION_SECRET": {"type": "string", "minLength": 32, "writeOnly": true},
    "CORS_ALLOWED_ORIGINS": {"type": "string", "minLength": 1},
    "DATABASE_URL": {"type": "string", "minLength": 1, "writeOnly": true},
    "DATABASE_SSL_MODE": {"type": "string", "enum": ["disable", "require", "verify-ca", "verify-full"]},
    "REDIS_URL": {"type": "string", "minLength": 1, "writeOnly": true},
    "S3_ENDPOINT": {"type": "string", "format": "uri"},
    "S3_BUCKET": {"type": "string", "minLength": 1},
    "S3_ACCESS_KEY_ID": {"type": "string", "minLength": 1, "writeOnly": true},
    "S3_SECRET_ACCESS_KEY": {"type": "string", "minLength": 1, "writeOnly": true},
    "INDEXER_START_BLOCK": {"type": "string", "pattern": "^[0-9]+$"},
    "INDEXER_CONFIRMATIONS": {"type": "string", "pattern": "^[0-9]+$"},
    "INDEXER_POLL_INTERVAL_SECONDS": {"type": "string", "pattern": "^[0-9]+$"},
    "INDEXER_BATCH_SIZE": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "NEXT_PUBLIC_API_URL": {"type": "string", "format": "uri"},
    "NEXT_PUBLIC_CHAIN_ID": {"type": "string", "pattern": "^[0-9]+$"},
    "NEXT_PUBLIC_RPC_URL": {"type": "string", "format": "uri"},
    "OTEL_EXPORTER_OTLP_ENDPOINT": {"type": "string", "format": "uri"},
    "SENTRY_DSN": {"type": "string", "format": "uri"},
    "AUDIT_EXPORT_BUCKET": {"type": "string", "minLength": 1}
  },
  "x-environments": {
    "local": {"allowPlaceholders": true, "chainIds": [31337], "notes": "Disposable local development only."},
    "ci": {"allowPlaceholders": true, "chainIds": [31337], "notes": "Ephemeral CI fixtures only."},
    "testnet": {"allowPlaceholders": false, "requires": ["CHAIN_ID", "RPC_URL", "CONTRACT_ADDRESS", "AUTH_JWKS_URL"], "notes": "Requires approved deployment and custody evidence."},
    "pilot": {"allowPlaceholders": false, "requires": ["CHAIN_ID", "RPC_URL", "CONTRACT_ADDRESS", "AUTH_JWKS_URL", "DATABASE_URL", "SESSION_SECRET"], "notes": "Requires organizational, privacy, security, and recovery approvals."},
    "production": {"allowPlaceholders": false, "requires": ["CHAIN_ID", "RPC_URL", "CONTRACT_ADDRESS", "AUTH_JWKS_URL", "DATABASE_URL", "SESSION_SECRET", "OTEL_EXPORTER_OTLP_ENDPOINT"], "notes": "Not permitted until all production gates are approved."}
  }
}
