{
  "name": "blockchain-secure-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "MVP smart-contract baseline for decentralized identity, RBAC, and NFT-backed digital assets",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "build": "hardhat compile",
    "deploy:local": "hardhat run contracts/scripts/deploy.ts",
    "validate:references": "python3 scripts/validate_references.py",
    "lint": "hardhat compile && tsc --noEmit",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/npm": "12.0.2",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "chai": "4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "semantic-release": "24.2.9",
    "ts-node": "^10.9.2",
    "typechain": "8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2"
  }
}
