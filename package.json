{
  "name": "blockchain-secure-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "description": "MVP smart-contract baseline for decentralized identity, RBAC, and NFT-backed digital assets",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "build": "hardhat build",
    "deploy:local": "hardhat run contracts/scripts/deploy.ts",
    "validate:references": "python3 scripts/validate_references.py",
    "validate:environment": "python3 scripts/validate_environment.py",
    "validate:markdown": "python3 scripts/validate_markdown_tables.py",
    "validate:deployment-policy": "python3 scripts/validate_deployment_policy.py",
    "validate:deployment-manifest": "python3 scripts/validate_deployment_manifest.py",
    "test:config": "PYTHONPATH=. python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "lint": "hardhat build && tsc --noEmit",
    "test": "hardhat test",
    "test:api": "PYTHONPATH=. python3 -m unittest discover -s services/api/tests -p 'test_*.py'",
    "test:services": "PYTHONPATH=. python3 -m unittest discover -s services -p 'test_*.py'",
    "test:coverage": "hardhat test --coverage"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "3.1.0",
    "@nomicfoundation/hardhat-typechain": "3.1.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/npm": "12.0.2",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@typechain/ethers-v6": "0.5.1",
    "@types/chai": "5.2.2",
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.30",
    "chai": "5.2.0",
    "ethers": "6.17.0",
    "fast-check": "4.9.0",
    "hardhat": "3.14.0",
    "semantic-release": "24.2.9",
    "mocha": "11.7.1",
    "typechain": "8.3.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2"
  }
}
