# Local final-project topology only: no signer, external identity verifier, KMS, or production deployment is included.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY services/api/requirements.lock /tmp/api-requirements.lock
COPY services/persistence/requirements.lock /tmp/persistence-requirements.lock
COPY services/storage/requirements.lock /tmp/storage-requirements.lock
RUN python -m pip install --require-hashes --requirement /tmp/api-requirements.lock \
    && python -m pip install --require-hashes --requirement /tmp/persistence-requirements.lock \
    && python -m pip install --require-hashes --requirement /tmp/storage-requirements.lock

RUN addgroup --system platform && adduser --system --ingroup platform platform
COPY --chown=platform:platform services /app/services
USER platform

CMD ["uvicorn", "services.api.asgi:app", "--host", "0.0.0.0", "--port", "8000"]
