# Copy this file to .env for local development.
# Never commit .env, private keys, seed phrases, passwords, or production credentials.

# Application
NODE_ENV=development
APP_ENV=local
APP_NAME=blockchain-secure-platform
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=info

# EVM network
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
CONFIRMATION_BLOCKS=1
# The MVP deploys one combined contract. Future decomposed services may add separate addresses.
CONTRACT_ADDRESS=
CONTRACT_DEPLOYMENT_VERSION=local

# Development-only signer placeholders. Use throwaway local accounts only.
DEPLOYER_PRIVATE_KEY=replace-with-local-only-test-key
ADMIN_PRIVATE_KEY=replace-with-local-only-test-key

# API authentication and session configuration (future service; unused by contract-only MVP)
AUTH_ISSUER=http://localhost:8000
AUTH_AUDIENCE=blockchain-secure-platform
AUTH_JWKS_URL=
SESSION_SECRET=replace-with-a-long-random-local-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL off-chain projection store (future indexer/API; unused by contract-only MVP)
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
DATABASE_POOL_SIZE=5
DATABASE_SSL_MODE=disable

# Redis / BullMQ optional jobs (future indexer/API; unused by contract-only MVP)
REDIS_URL=redis://localhost:6379/0
QUEUE_PREFIX=blockchain-secure-platform

# S3-compatible object storage for permitted encrypted off-chain data (future service)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=platform-local
S3_ACCESS_KEY_ID=replace-with-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret-key
S3_FORCE_PATH_STYLE=true

# Indexer (future service)
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=1
INDEXER_POLL_INTERVAL_SECONDS=5
INDEXER_BATCH_SIZE=100

# Frontend-safe public configuration only; do not place secrets in NEXT_PUBLIC_* variables. (future frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Monitoring and audit integrations. Keep disabled locally unless configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
AUDIT_EXPORT_BUCKET=

# Test-only options
E2E_BASE_URL=http://localhost:3000
CYPRESS_API_URL=http://localhost:8000
